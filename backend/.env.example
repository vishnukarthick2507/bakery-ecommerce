
# Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017/sv-sweets-bakers
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo (transactional email API; names only, never commit secret values)
# ADMIN_NOTIFICATION_EMAIL receives admin security/operational alerts (e.g. admin login alerts). Required for alert delivery.
# Provider-side retention and mailbox access require separate operational verification.
ADMIN_NOTIFICATION_EMAIL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=S.V. Sweets & Bakers

# Cloudinary (for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business Cloud API (names only; never commit real secrets/tokens)
# Production messaging is NOT ready by setting these values alone: W01/legal,
# Meta business verification, template approval/evidence, UAT authorization,
# and D-19 production GO are still required.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=


# Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017/sv-sweets-bakers
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
